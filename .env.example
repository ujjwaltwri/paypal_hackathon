# --- PayPal (sandbox) -------------------------------------------------------
# developer.paypal.com/dashboard → Apps & Credentials → Sandbox → Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- LLM: set ONE of these (any provider works via the Vercel AI SDK) -------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# Optional: override the default model for the chosen provider
# LLM_MODEL=

# --- Optional ----------------------------------------------------------------
# Show the 7 built-in demo disputes alongside live sandbox ones (default: true)
# INCLUDE_DEMO_DISPUTES=true
# Cost assumptions used in expected-value maths (USD)
# CHARGEBACK_FEE_ESTIMATE=20
# DISPUTE_HANDLING_COST=10
